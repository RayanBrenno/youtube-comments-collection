# Copie para backend/.env e preencha. O .env nunca deve ser versionado.

# MongoDB (Atlas ou local, ex.: mongodb://localhost:27017)
MONGO_URL=mongodb+srv://usuario:senha@cluster.mongodb.net/
MONGO_DB=projetoYoutube

# Chave da YouTube Data API v3 (console.cloud.google.com)
YOUTUBE_API_KEY=cole-sua-chave-aqui

# Assinatura dos tokens JWT. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-um-valor-aleatorio

# Origem do frontend liberada no CORS (várias separadas por vírgula).
# localhost e 127.0.0.1 são liberados juntos automaticamente.
API_FRONT_URL=http://localhost:5173

# --- Classificação de sentimento ---------------------------------------------------
# Classificador usado quando o front não escolhe um:
#   bertimbau-large | bertimbau-base | xlm-roberta | distilbert
#   claude-haiku-5-5 | claude-sonnet-5-5 | claude-opus-5-5
CLASSIFICADOR_PADRAO=bertimbau-large

# Pasta com os encoders fine-tuned da Etapa 2 (gerados pelo run.py de scripts/encoders/).
# Caminho relativo é resolvido a partir de backend/.
MODELOS_DIR=../scripts/encoders/modelos/etapa2

# Chave da API da Anthropic (console.anthropic.com), só para os modelos Claude.
# Sem ela, os modelos Claude aparecem como indisponíveis. O billing da API é separado do
# plano Claude Pro.
ANTHROPIC_API_KEY=sk-ant-cole-sua-chave-aqui
